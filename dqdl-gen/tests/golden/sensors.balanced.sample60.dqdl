# Generated by dqdl-gen from sensors.parquet (parquet).
# 60 of 300 rows profiled from a sample, 5 columns. Strictness: balanced.
# Rule types verified against AWS's DQDL parser on 2026-09-23: https://github.com/awslabs/dqdl
#
# A generated ruleset is a starting point derived from one profile of one file. Review it
# before committing it to a pipeline: the tool describes the data it was shown, which is not
# the same as the data you expect tomorrow.

Rules = [
    # 300 rows in the file, allowing 20% either way at balanced strictness
    RowCount between 240 and 360,

    # 5 columns in the profiled file
    ColumnCount = 5,

    # no nulls in 60 rows; from a sample of 60 of 300 rows
    IsComplete "sensor_id",

    # observed lengths 4 to 4 characters, padded by 1 at balanced strictness; from a sample of
    # 60 of 300 rows
    ColumnLength "sensor_id" between 3 and 5,

    # no nulls in 60 rows; from a sample of 60 of 300 rows
    IsComplete "reading_c",

    # observed 20 to 44.5, widened by 5% at balanced strictness; from a sample of 60 of 300
    # rows
    ColumnValues "reading_c" between 18.775 and 45.725,

    # read as double; from a sample of 60 of 300 rows
    ColumnDataType "reading_c" = "Double",

    # 58 of 60 rows non-null (0.967 observed), less a 0.01 margin at balanced strictness; from
    # a sample of 60 of 300 rows
    Completeness "battery_pct" >= 0.95,

    # all 58 non-null values distinct, but 2 rows are null, so this is unique without being a
    # key; from a sample of 60 of 300 rows
    IsUnique "battery_pct",

    # observed 1 to 59, widened by 5% at balanced strictness; from a sample of 60 of 300 rows
    ColumnValues "battery_pct" between -2 and 62,

    # read as int64; from a sample of 60 of 300 rows
    ColumnDataType "battery_pct" = "Long",

    # no nulls in 60 rows; from a sample of 60 of 300 rows
    IsComplete "calibrated",

    # read as bool; from a sample of 60 of 300 rows
    ColumnDataType "calibrated" = "Boolean",

    # no nulls in 60 rows; from a sample of 60 of 300 rows
    IsComplete "firmware",

    # 1 distinct values across 60 non-null rows: 4.2.1 (60); from a sample of 60 of 300 rows
    ColumnValues "firmware" in ["4.2.1"],

    # 1 distinct values observed; this guards against the set collapsing, while the
    # allowed-value rule guards against it growing; from a sample of 60 of 300 rows
    DistinctValuesCount "firmware" between 1 and 1,

    # observed lengths 5 to 5 characters, padded by 1 at balanced strictness; from a sample of
    # 60 of 300 rows
    ColumnLength "firmware" between 4 and 6
]
