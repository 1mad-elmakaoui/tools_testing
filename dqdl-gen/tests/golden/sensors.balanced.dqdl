# Generated by dqdl-gen from sensors.parquet (parquet).
# 300 rows profiled, 5 columns. Strictness: balanced.
# Rule types verified against AWS's DQDL parser on 2026-09-23: https://github.com/awslabs/dqdl
#
# A generated ruleset is a starting point derived from one profile of one file. Review it
# before committing it to a pipeline: the tool describes the data it was shown, which is not
# the same as the data you expect tomorrow.

Rules = [
    # 300 rows in the file, allowing 20% either way at balanced strictness
    RowCount between 240 and 360,

    # 5 columns in the profiled file
    ColumnCount = 5,

    # no nulls in 300 rows
    IsComplete "sensor_id",

    # 8 distinct values across 300 non-null rows: S000 (38), S001 (38), S002 (38), S003 (38),
    # S004 (37), and 3 more
    ColumnValues "sensor_id" in ["S000", "S001", "S002", "S003", "S004", "S005", "S006", "S007"],

    # 8 distinct values observed; this guards against the set collapsing, while the
    # allowed-value rule guards against it growing
    DistinctValuesCount "sensor_id" between 1 and 8,

    # observed lengths 4 to 4 characters, padded by 1 at balanced strictness
    ColumnLength "sensor_id" between 3 and 5,

    # no nulls in 300 rows
    IsComplete "reading_c",

    # observed 20 to 44.5, widened by 5% at balanced strictness
    ColumnValues "reading_c" between 18.775 and 45.725,

    # read as double
    ColumnDataType "reading_c" = "Double",

    # 290 of 300 rows non-null (0.967 observed), less a 0.01 margin at balanced strictness
    Completeness "battery_pct" >= 0.95,

    # observed 0 to 99, widened by 5% at balanced strictness
    ColumnValues "battery_pct" between -5 and 104,

    # read as int64
    ColumnDataType "battery_pct" = "Long",

    # no nulls in 300 rows
    IsComplete "calibrated",

    # read as bool
    ColumnDataType "calibrated" = "Boolean",

    # no nulls in 300 rows
    IsComplete "firmware",

    # 1 distinct values across 300 non-null rows: 4.2.1 (300)
    ColumnValues "firmware" in ["4.2.1"],

    # 1 distinct values observed; this guards against the set collapsing, while the
    # allowed-value rule guards against it growing
    DistinctValuesCount "firmware" between 1 and 1,

    # observed lengths 5 to 5 characters, padded by 1 at balanced strictness
    ColumnLength "firmware" between 4 and 6
]
